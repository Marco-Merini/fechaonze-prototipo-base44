{
  "name": "CourtBlock",
  "type": "object",
  "properties": {
    "court_id": {
      "type": "string",
      "description": "ID da quadra"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do bloqueio"
    },
    "start_time": {
      "type": "string",
      "description": "Horario inicial (opcional)"
    },
    "end_time": {
      "type": "string",
      "description": "Horario final (opcional)"
    },
    "reason": {
      "type": "string",
      "description": "Motivo do bloqueio"
    }
  },
  "required": [
    "court_id",
    "date"
  ]
}